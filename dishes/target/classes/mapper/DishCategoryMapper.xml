<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ttt.dishes.mapper.DishCategoryMapper">
    <insert id="saveCategory">
        insert into t_dish_category(name)values (#{name})
    </insert>

    <select id="getCategoriesByIds" resultType="com.ttt.entity.dishes.DishCategory">
    SELECT * FROM t_dish_category
    WHERE id IN
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <select id="getIdByName" resultType="java.lang.Long">
        select id from t_dish_category where name=#{name}
    </select>
</mapper>